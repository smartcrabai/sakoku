{
  extends: [
    "config:best-practices"
  ],
  dependencyDashboard: false,
  // Scan the central source file for Renovate only in the terraforms repository
  // (additive, so the default patterns are still kept; this path does not
  // exist in the distribution target repositories).
  "github-actions": {
    managerFilePatterns: [
      "/(^|/)environments/shared/cruise/workflow\\.yml$/"
    ],
  },
  minimumReleaseAge: "3 days",
  lockFileMaintenance: {
    minimumReleaseAge: null,
  },
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      matchUpdateTypes: [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      groupName: "all minor, patch, and digest updates",
      groupSlug: "all-minor-patch-digest-updates",
    },
    {
      matchUpdateTypes: [
        "major"
      ],
      prBodyNotes: [
        "<!-- renovate-major-update -->"
      ],
    },
    {
      matchManagers: [
        "github-actions"
      ],
      minimumReleaseAge: "7 days"
    },
    {
      // Digests / pinDigests have no releaseTimestamp. Applying
      // minimumReleaseAge would make stabilityStatus=yellow unconditionally
      // because the default minimumReleaseAgeBehaviour is timestamp-required,
      // leaving renovate/stability-days permanently pending. A digest follows
      // the same tag, so a release-age delay does not apply. Keep this rule last
      // so it overrides the github-actions rule above.
      matchUpdateTypes: [
        "digest",
        "pinDigest"
      ],
      minimumReleaseAge: null,
    }
  ]
}
